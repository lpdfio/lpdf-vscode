{
  "name": "lpdf",
  "displayName": "Lpdf",
  "description": "View PDFs, compare modified PDFs with your last commit, and author PDFs in XML. Lpdf: PDF as Code on every platform.",
  "license": "SEE LICENSE IN LICENSE",
  "publisher": "lpdfio",
  "version": "0.0.0",
  "preview": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#141414",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lpdfio/lpdf-vscode"
  },
  "bugs": {
    "url": "https://github.com/lpdfio/lpdf/issues"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=18.17.1"
  },
  "extensionDependencies": [
    "redhat.vscode-xml"
  ],
  "keywords": [
    "pdf",
    "xml",
    "pdf viewer",
    "pdf diff",
    "pdf compare",
    "pdf preview",
    "pdf export",
    "pdf create",
    "pdf design",
    "document",
    "template"
  ],
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:xml",
    "workspaceContains:**/*.pdf"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "lpdf.pdfViewer",
        "displayName": "Lpdf Viewer",
        "selector": [{ "filenamePattern": "*.pdf" }],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Lpdf",
      "properties": {
        "lpdf.defaultPdfViewer": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Use the Lpdf viewer as the default viewer for PDF files. When enabled, clicking a .pdf file opens it in the Lpdf PDF viewer instead of VS Code's default binary viewer."
        },
        "lpdf.promptPdfDiff": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "When a changed PDF opens as a text diff, for example from the Source Control view, offer to open it in the Lpdf visual diff instead."
        }
      }
    },
    "commands": [
      { "command": "lpdf.newDocument",    "title": "Lpdf: New Document..." },
      { "command": "lpdf.openPdf",        "title": "Lpdf: View PDF" },
      { "command": "lpdf.previewPdf",     "title": "Lpdf: Preview PDF", "icon": "media/lpdf-mark.svg" },
      { "command": "lpdf.exportPdf",      "title": "Lpdf: Export PDF"  },
      { "command": "lpdf.generateHere",   "title": "Lpdf: Generate Code" },
      { "command": "lpdf.linkDataFile",   "title": "Lpdf: Link Data File..."  },
      { "command": "lpdf.unlinkDataFile", "title": "Lpdf: Unlink Data File"   },
      { "command": "lpdf.generateTs",     "title": "Lpdf: Generate TypeScript from XML" },
      { "command": "lpdf.generateCs",     "title": "Lpdf: Generate C# from XML" },
      { "command": "lpdf.generatePy",     "title": "Lpdf: Generate Python from XML" },
      { "command": "lpdf.generatePhp",    "title": "Lpdf: Generate PHP from XML" },
      { "command": "lpdf.diffPdf",        "title": "Lpdf: Compare PDF with HEAD" }
    ],
    "menus": {
      "file/newFile": [
        {
          "command": "lpdf.newDocument",
          "group": "file"
        }
      ],
      "editor/title": [
        {
          "when": "lpdf.isLpdfDocument",
          "command": "lpdf.previewPdf",
          "group": "navigation"
        },
        {
          "when": "resourceExtname == .pdf",
          "command": "lpdf.diffPdf",
          "group": "1_lpdf"
        }
      ],
      "explorer/context": [
        {
          "when": "explorerResourceIsFolder",
          "command": "lpdf.newDocument",
          "group": "2_z_lpdf@0"
        },
        {
          "when": "resourceExtname == .pdf",
          "command": "lpdf.openPdf",
          "group": "2_z_lpdf@1"
        },
        {
          "when": "resourceExtname == .pdf",
          "command": "lpdf.diffPdf",
          "group": "2_z_lpdf@2"
        },
        {
          "when": "resourceExtname == .xml",
          "command": "lpdf.previewPdf",
          "group": "2_z_lpdf@1"
        },
        {
          "when": "resourceExtname == .xml",
          "command": "lpdf.exportPdf",
          "group": "2_z_lpdf@2"
        },
        {
          "when": "resourceExtname == .xml",
          "command": "lpdf.generateHere",
          "group": "2_z_lpdf@3"
        }      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "docs:images": "node scripts/label-screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^2.0.0",
    "happy-dom": "^20.14.5",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  }
}
