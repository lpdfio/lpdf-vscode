<lpdf version="1">
  <!--
    An invoice whose values come from data: the .json file with the same name, next to this one.
    The preview reads it too, and updates when you save either file.

      data-value="customer.name"   replaces the text with that value
      data-source="items"          repeats the element once for each item of a list
      data-if="notes"              shows the element only when the value is there

    The text inside an element is what shows without data. Lpdf places each value as it is, so
    format numbers and dates in the JSON, or in the code that writes it.
    Docs: https://lpdf.io/docs/
  -->
  <tokens>
    <colors>
      <color name="primary"    value="#1d4ed8" />
      <color name="surface"    value="#ffffff" />
      <color name="text-muted" value="#737373" />
      <color name="rule"       value="#dde3ed" />
      <color name="accent"     value="#e8f0fc" />
    </colors>
  </tokens>
  <document size="a4" margin="40pt">
    <meta title="Invoice" subject="Invoice" />
    <section background="surface">
      <layout>
      <stack gap="l" height="full" justify="between">

        <!-- header: who sends it, and the invoice number -->
        <flank gap="m" align="start" end="true">
          <stack gap="xs">
            <text font-size="xl" font="Helvetica-Bold" color="primary" data-value="seller.name">Acme Corp</text>
            <text font-size="s" color="text-muted" data-value="seller.street">123 Business Ave, Suite 4</text>
            <text font-size="s" color="text-muted" data-value="seller.city">San Francisco, CA 94107</text>
            <text font-size="s" color="text-muted" data-value="seller.email">billing@acmecorp.example</text>
          </stack>
          <stack gap="xs" align="end">
            <text font-size="xxl" font="Helvetica-Bold" color="primary">INVOICE</text>
            <text font-size="s" color="text-muted" data-value="invoice.number">INV-1042</text>
          </stack>
        </flank>

        <divider color="rule" thickness="xs" />

        <!-- who pays it, and when -->
        <split gap="l" align="start">
          <stack gap="xs">
            <text font-size="s" font="Helvetica-Bold" color="text-muted">BILL TO</text>
            <text font-size="m" font="Helvetica-Bold" data-value="customer.name">Bright Labs LLC</text>
            <text font-size="s" color="text-muted" data-value="customer.street">456 Client Street</text>
            <text font-size="s" color="text-muted" data-value="customer.city">Austin, TX 78701</text>
            <text font-size="s" color="text-muted" data-value="customer.email">accounts@brightlabs.example</text>
          </stack>
          <stack gap="xs" align="end">
            <flank gap="m" align="center" end="true">
              <text font-size="s" color="text-muted">Issue date</text>
              <text font-size="s" data-value="invoice.issued">April 1, 2026</text>
            </flank>
            <flank gap="m" align="center" end="true">
              <text font-size="s" color="text-muted">Due date</text>
              <text font-size="s" font="Helvetica-Bold" data-value="invoice.due">April 30, 2026</text>
            </flank>
            <flank gap="m" align="center" end="true">
              <text font-size="s" color="text-muted">Payment terms</text>
              <text font-size="s" data-value="invoice.terms">Net 30</text>
            </flank>
          </stack>
        </split>

        <divider color="rule" thickness="xs" />

        <!-- the line items: a header row, then one row for each item in the data -->
        <frame background="accent" padding="s" radius="xs">
          <flank gap="m" align="center" end="true">
            <text font-size="s" font="Helvetica-Bold">Description</text>
            <text width="30pt" font-size="s" font="Helvetica-Bold" align="right">Qty</text>
            <text width="60pt" font-size="s" font="Helvetica-Bold" align="right">Unit price</text>
            <text width="60pt" font-size="s" font="Helvetica-Bold" align="right">Amount</text>
          </flank>
        </frame>

        <stack gap="xs" height="fill">
          <stack gap="xs" data-source="items">
            <flank gap="m" align="center" end="true">
              <stack gap="xs">
                <text font-size="m" data-value="description">Platform license, Pro tier (annual)</text>
                <text font-size="s" color="text-muted" data-value="detail">Unlimited users, SSO, audit logs</text>
              </stack>
              <text width="30pt" font-size="m" align="right" data-value="quantity">1</text>
              <text width="60pt" font-size="m" align="right" data-value="unitPrice">$4,800.00</text>
              <text width="60pt" font-size="m" font="Helvetica-Bold" align="right" data-value="amount">$4,800.00</text>
            </flank>
            <divider color="rule" thickness="xs" />
          </stack>
        </stack>

        <!-- totals -->
        <cluster justify="end">
          <stack gap="xs" width="200pt">
            <flank gap="m" align="center" end="true">
              <text font-size="s" color="text-muted">Subtotal</text>
              <text font-size="s" align="right" data-value="subtotal">$7,000.00</text>
            </flank>
            <flank gap="m" align="center" end="true">
              <text font-size="s" color="text-muted" data-value="tax.label">Tax (8.625%)</text>
              <text font-size="s" align="right" data-value="tax.amount">$603.75</text>
            </flank>
            <divider color="rule" thickness="xs" />
            <flank gap="m" align="center" end="true">
              <text font-size="l" font="Helvetica-Bold">Total due</text>
              <text font-size="l" font="Helvetica-Bold" color="primary" align="right" data-value="total">$7,603.75</text>
            </flank>
          </stack>
        </cluster>

        <divider color="rule" thickness="xs" />

        <!-- how to pay; the notes line shows only when the data has notes -->
        <stack gap="xs">
          <text font-size="s" font="Helvetica-Bold">Payment instructions</text>
          <text font-size="s" color="text-muted" data-value="payment">Wire transfer to First National Bank, routing 021000021, account 987654321, reference INV-1042</text>
          <text font-size="s" color="text-muted" data-if="notes" data-value="notes">Thank you for your business.</text>
        </stack>

      </stack>
      </layout>
    </section>
  </document>
</lpdf>
